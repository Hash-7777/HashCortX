{
  "$schema": "https://schema.tauri.app/config/2",

  "productName": "HashCortx",
  "version": "2.5.0",

  // ── Bundle identifier ──────────────────────────────────────────
  // This string permanently identifies the app on every platform.
  // It is used by:
  //   • macOS Keychain (API key storage)
  //   • Windows Credential Manager
  //   • Auto-updater signatures
  //   • App Store (if submitted later)
  //
  // ⚠ NEVER change this after shipping to real users.
  //   Changing it breaks Keychain access and update signatures.
  //   If you buy hashcortx.com later, you can note the domain in
  //   the README but do NOT change this identifier.
  "identifier": "com.hashcortx.app",

  "build": {
    // ── Frontend source ────────────────────────────────────────
    // Phase 0–2: served directly from /src (no build step needed).
    // Phase 3+: switch to "../dist" and add Vite if complexity grows.
    "frontendDist": "../src"
  },

  "app": {
    // ── withGlobalTauri ────────────────────────────────────────
    // Exposes window.__TAURI__ in JS so platform/tauri/*.js can
    // call Rust commands. Must stay true.
    "withGlobalTauri": true,

    "windows": [
      {
        "title": "HashCortx",
        "width": 1380,
        "height": 860,

        // Minimum size — below this the layout breaks
        "minWidth": 960,
        "minHeight": 640,

        // ── titleBarStyle: Overlay ─────────────────────────────
        // Hides the default Mac title bar (white bar with red/yellow/green dots).
        // Our custom header draws its own traffic lights via CSS.
        // Remove this if you want the default Mac chrome back.
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,

        // acceptFirstMouse — first click focuses the window AND fires WebView events.
        // Without this, macOS swallows the mousedown for focus, so Tauri's
        // data-tauri-drag-region handler never fires on that first click.
        "acceptFirstMouse": true,

        // Open centered on first launch. The window starts hidden so JS can
        // restore the saved size/position before the first visible paint.
        "center": true,
        "visible": false
      }
    ],

    "security": {
      // ── Content Security Policy ────────────────────────────────
      // Locks down what the app can load and connect to.
      // Each domain listed is an AI provider the user can add API keys for.
      //
      // HOW TO ADD A NEW PROVIDER:
      //   Append its API base domain to connect-src.
      //   Example: add "https://api.newprovider.com" to allow it.
      //
      // ⚠ A wildcard host grants every host on that port. There is exactly
      //   ONE here — http://*:11434 — because Ollama's port is the only local
      //   server the app talks to and it may live on another machine on the
      //   user's network. Ports 1234, 8080 and 11435 used to be listed the
      //   same way for "self-hosted model servers"; nothing in this app has
      //   ever connected to them, so they granted plaintext access to any
      //   host on the internet's most common alternate web ports in exchange
      //   for no feature at all. Do not add another without a caller.
      //
      // ── img-src ────────────────────────────────────────────────
      // 'self' data: blob: — and deliberately NOT https:.
      //
      // Nothing in this app loads a picture from the network: every image is
      // a bundled asset, a data: URL (a generated or pasted image) or a
      // blob:. Allowing https: meant a markdown image in a model's reply —
      // ![](https://host/?...) — fetched that host the moment the reply was
      // drawn, with no click. For an app whose agent reads files and web
      // pages, that is a way for injected text to send what it just read
      // somewhere, in a request the user never sees. Chat renders a remote
      // image as a link now (see markdownRenderer in app.js); this line is
      // what enforces it.
      //
      // ipc: and http://ipc.localhost are required by Tauri internals.
      // 'unsafe-inline' on style-src is needed for our dynamic theme tokens.
      //
      // script-src once allowed three CDNs. Two are gone: cdnjs.cloudflare.com
      // was never used at all, and cdn.sheetjs.com is now vendored. jsdelivr
      // remains for ONE reason — Pyodide, whose runtime pulls CPython plus
      // pandas/numpy/matplotlib wheels on demand and cannot sensibly be
      // shipped in the app. three.js and its loaders used to come from there
      // too; they are vendored now, so 3D Forge works with the network off.
      //
      // Before adding a host here, vendor the library instead. That rule is in
      // ARCHITECTURE.md and this list is where breaking it shows up.
      // ── connect-src and the code must name the SAME host ───────────
      // A host listed here that nothing calls grants reach for no
      // feature. A host the code calls that is NOT listed fails as an
      // ordinary network error, which the app reports as the service
      // being unreachable — a feature that looks broken for a reason
      // nothing in the interface can explain.
      //
      // Three had drifted apart, and each cost a shipped feature:
      //   • the Google search tool calls customsearch.googleapis.com;
      //     the code asked www.googleapis.com, which is not listed
      //   • the PubMed tool reads Europe PMC at www.ebi.ac.uk; only
      //     eutils.ncbi.nlm.nih.gov was listed, which nothing calls
      //   • Pyodide fetches its runtime from cdn.jsdelivr.net. That host
      //     was in script-src only, so the script tag loaded and the
      //     runtime fetch behind it did not
      // api.together.xyz was listed with no caller anywhere and is gone.
      //
      // scripts/checks/csp.mjs now pins both directions. Note that
      // `tauri dev` applies NO policy at all — these rules only take
      // effect in `tauri build`, which is why the drift went unseen.
      //
      // ── 'wasm-unsafe-eval' ─────────────────────────────────────────
      // The Python sandbox is CPython compiled to WebAssembly, and
      // compiling a WebAssembly module counts as evaluating script. With
      // neither 'unsafe-eval' nor 'wasm-unsafe-eval' listed, every
      // WebAssembly.instantiate call was refused outright, so the sandbox
      // could not run in any shipped build however well the network
      // behaved.
      //
      // 'wasm-unsafe-eval' permits WebAssembly and NOTHING else: eval()
      // and new Function() stay refused, which is the pair that turns an
      // injected string into running script. Full 'unsafe-eval' would
      // permit all three and must not be added — the sandbox does not
      // need it.
      "csp": "default-src 'self' ipc: http://ipc.localhost; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval' https://cdn.jsdelivr.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob:; connect-src 'self' https://api.anthropic.com https://api.openai.com https://openrouter.ai https://api.groq.com https://api.cerebras.ai https://api.mistral.ai https://generativelanguage.googleapis.com https://api.sambanova.ai https://api.kimi.com https://api.kimi.ai https://api.moonshot.ai https://api.moonshot.cn https://api.deepseek.com https://integrate.api.nvidia.com https://api.tavily.com https://customsearch.googleapis.com https://en.wikipedia.org https://www.ebi.ac.uk https://api.duckduckgo.com https://cdn.jsdelivr.net http://localhost:11434 http://127.0.0.1:11434 http://*:11434"
    }
  },

  "bundle": {
    "active": true,

    // ── Build targets ──────────────────────────────────────────
    // "all" = build every format available for the current OS:
    //   macOS  → .dmg + .app
    //   Windows → .exe (NSIS installer) + .msi
    //   Linux  → .AppImage + .deb
    "targets": "all",

    // ── App icons ─────────────────────────────────────────────
    // These are auto-generated from a master 1024×1024 PNG.
    // To regenerate after changing the logo:
    //   1. Place your new logo at src/assets/icon-master.png
    //   2. Run: npm run tauri icon src/assets/icon-master.png
    //   3. Tauri will overwrite all sizes here automatically.
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],

    // App Store category — affects discoverability if submitted later
    "category": "DeveloperTool",

    "shortDescription": "Local-first AI coding agents",
    "longDescription": "HashCortx — 100% local AI coding agents. No cloud, no tracking. Your API keys stay in your keychain. Your files never leave your machine.",

    "macOS": {
      // Minimum macOS version. 10.15 (Catalina) supports all Tauri features.
      // Lower = more compatibility, higher = newer APIs available.
      "minimumSystemVersion": "10.15",

      // ── Code signing ──────────────────────────────────────────
      // null = unsigned (shows "unidentified developer" warning on first open).
      // To sign: buy Apple Developer account ($99/yr), set signingIdentity
      // to your certificate name (e.g. "Developer ID Application: Your Name").
      // See docs/future/SIGNING.md when you're ready.
      "signingIdentity": null,
      "entitlements": null
    },

    "windows": {
      // SHA-256 is the modern standard for Windows code signing.
      // certificateThumbprint is null until you have a Windows code signing cert.
      "digestAlgorithm": "sha256",
      "certificateThumbprint": null
    }
  }

  // ── Auto-updater (DISABLED — future feature) ───────────────────
  // When you're ready to enable auto-updates:
  //   1. Set up a GitHub repo and publish releases
  //   2. Uncomment this block
  //   3. Replace YOUR_USERNAME with your GitHub username
  //   4. Generate an updater keypair: npm run tauri signer generate
  //   5. Add the public key to pubkey below
  //   6. Add the private key as a GitHub Actions secret
  //
  // "plugins": {
  //   "updater": {
  //     "pubkey": "YOUR_PUBLIC_KEY_HERE",
  //     "endpoints": [
  //       "https://github.com/YOUR_USERNAME/HashCortx/releases/latest/download/latest.json"
  //     ]
  //   }
  // }
}
